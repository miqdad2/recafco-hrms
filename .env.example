# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/recafco_hrms_dev?schema=public"

# API
API_PORT=4000
JWT_ACCESS_SECRET="change-this-access-secret-to-a-long-random-value"
JWT_REFRESH_SECRET="change-this-refresh-secret-to-a-different-long-random-value"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bootstrap (used only by `create:super-admin`, never read by the running app)
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD="change-this-to-a-strong-password"
BOOTSTRAP_ADMIN_EMAIL=

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

# Redis
REDIS_URL="redis://localhost:6379"
