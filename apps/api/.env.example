# Copy to apps/api/.env for local development.
NODE_ENV=development
API_PORT=4000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/recafco_hrms_dev?schema=public"
JWT_ACCESS_SECRET="change-this-access-secret-to-a-long-random-value"
JWT_REFRESH_SECRET="change-this-refresh-secret-to-a-different-long-random-value"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bootstrap (used only by `pnpm create:super-admin`, never read by the running app)
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD="change-this-to-a-strong-password"
BOOTSTRAP_ADMIN_EMAIL=
