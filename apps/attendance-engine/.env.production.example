# RECAFCO attendance engine — PRODUCTION configuration template.
# NOT deployed in RUST-01. Provide these through the process manager / container environment,
# never by committing a filled-in copy. Secrets belong in the deployment secret store.

ATTENDANCE_ENGINE_ENV=production

# Internal-only service: keep it on loopback or the private Docker network, never public.
ATTENDANCE_ENGINE_HOST=127.0.0.1
ATTENDANCE_ENGINE_PORT=4100

# REQUIRED in production — startup fails with exit code 2 if missing or malformed.
# Must be the dedicated read-only role until a later unit explicitly grants write ownership.
ATTENDANCE_ENGINE_DATABASE_URL=postgresql://recafco_engine_ro:<from-secret-store>@<db-host>:5432/recafco_hrms

ATTENDANCE_ENGINE_DB_MAX_CONNECTIONS=10
ATTENDANCE_ENGINE_DB_MIN_CONNECTIONS=1
ATTENDANCE_ENGINE_DB_ACQUIRE_TIMEOUT_MS=3000
ATTENDANCE_ENGINE_DB_STATEMENT_TIMEOUT_MS=5000

ATTENDANCE_ENGINE_READINESS_TIMEOUT_MS=2000
ATTENDANCE_ENGINE_REQUEST_TIMEOUT_MS=10000
ATTENDANCE_ENGINE_SHUTDOWN_GRACE_MS=15000

ATTENDANCE_ENGINE_LOG_FORMAT=json
RUST_LOG=info
