# RECAFCO attendance engine — DEVELOPMENT configuration template.
# Copy to apps/attendance-engine/.env (git-ignored). Only that exact file is loaded; the
# monorepo root .env is NOT read, so the NestJS API's secrets never leak into this process.

ATTENDANCE_ENGINE_ENV=development

# Bind to loopback only. Port 4100 does not collide with web (3000), api (4000),
# PostgreSQL (5432) or Expo/Metro (8081).
ATTENDANCE_ENGINE_HOST=127.0.0.1
ATTENDANCE_ENGINE_PORT=4100

# Optional in development. When unset, /ready honestly reports 503 "not_configured".
# Use a dedicated READ-ONLY role (see README "Read-only database role"). Every session is
# additionally forced to default_transaction_read_only=on by the engine itself.
# ATTENDANCE_ENGINE_DATABASE_URL=postgresql://recafco_engine_ro:CHANGE_ME@localhost:5432/recafco_hrms_dev

# Connection pool limits (kept small: the NestJS API shares the same PostgreSQL max_connections).
ATTENDANCE_ENGINE_DB_MAX_CONNECTIONS=5
ATTENDANCE_ENGINE_DB_MIN_CONNECTIONS=0
ATTENDANCE_ENGINE_DB_ACQUIRE_TIMEOUT_MS=3000
ATTENDANCE_ENGINE_DB_STATEMENT_TIMEOUT_MS=5000

ATTENDANCE_ENGINE_READINESS_TIMEOUT_MS=2000
ATTENDANCE_ENGINE_REQUEST_TIMEOUT_MS=10000
ATTENDANCE_ENGINE_SHUTDOWN_GRACE_MS=10000

# json (default, structured) or pretty (human-readable, development only).
ATTENDANCE_ENGINE_LOG_FORMAT=pretty
RUST_LOG=info,recafco_attendance_engine=debug
