{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleDetection": "force",
    "customConditions": [
      "react-native"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ],
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
