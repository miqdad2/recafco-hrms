# API base URL the mobile app calls. EXPO_PUBLIC_-prefixed vars are inlined into the
# JS bundle at build time by Expo — never put secrets here, this is client-visible.
#
# The right value depends on how you're running the app against your local API
# (pnpm --filter @recafco/api dev, listening on localhost:4000):
#
# - Android emulator: the emulator's "localhost" is its own virtual device, not your PC.
#     10.0.2.2 is the emulator's special alias for the host machine's localhost.
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
#
# - Physical Android/iOS device on the same Wi-Fi/LAN as your PC:
#     replace with your PC's actual LAN IP (e.g. `ipconfig` on Windows, look for
#     the Wi-Fi/Ethernet adapter's IPv4 address).
#   EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:4000
#
# - iOS simulator (Mac only): the simulator shares the Mac's network namespace,
#     so plain localhost works.
#   EXPO_PUBLIC_API_URL=http://localhost:4000

EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
